# Copiar a frontend/.env.local y completar solo el archivo local ignorado por Git.
# Todo NEXT_PUBLIC_* es publico: nunca colocar service_role ni tokens privados.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Incluir /api, como esperan los clientes HTTP existentes.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Opcional; actualmente no consumida por el codigo del frontend.
NEXT_PUBLIC_MP_PUBLIC_KEY=
