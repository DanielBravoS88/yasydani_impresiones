# Copiar a backend/.env y completar solo el archivo local ignorado por Git.
# No publicar credenciales ni usar credenciales de produccion para pruebas.
# Ejecutar los comandos del backend desde su workspace.

NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
# Activar solo si existe un proxy confiable configurado.
TRUST_PROXY=false

# URL del proyecto y clave publica para verificar usuarios autenticados.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Clave privilegiada: exclusiva del backend, nunca del navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Token privado. Dejar vacio deshabilita la creacion de preferencias.
# Para pruebas externas usar una cuenta de prueba confirmada y autorizada.
MERCADOPAGO_ACCESS_TOKEN=
