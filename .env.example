# Plantilla de referencia: nunca incluir credenciales reales en este archivo.
# La aplicacion usa frontend/.env.local y backend/.env; este archivo no los sustituye.
# Copiar las plantillas de cada workspace a su archivo local correspondiente.
# Las claves se dejan vacias deliberadamente. Configurarlas solo en archivos ignorados.

# Frontend: estos valores son publicos y se incluyen en el navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Opcional; actualmente no consumida por el codigo del frontend.
NEXT_PUBLIC_MP_PUBLIC_KEY=

# Backend: nunca usar prefijo NEXT_PUBLIC_ para credenciales privadas.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MERCADOPAGO_ACCESS_TOKEN=
# Secreto privado de firma; configurar exclusivamente en el backend.
# Vacio: webhook responde 503 sin procesar. Firma ausente/invalida: 401.
MERCADOPAGO_WEBHOOK_SECRET=

# Variable heredada no consumida por el codigo actual. No concede acceso administrativo.
ADMIN_SETUP_SECRET=

NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
# Activar solo si existe un proxy confiable configurado.
TRUST_PROXY=false
